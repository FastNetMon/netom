# Build artifacts
/target

# Hidden files: editor, OS and local tool state.
# Whitelist the ones that belong in the repository.
.*
!/.gitignore
!/.github/
!/.dockerignore
!/.gcloudignore

# Logs, archives and local data
*.log
*.gz
# Local MRT dumps and other bulk test inputs live here and stay untracked,
# but the small captured API responses the netom-cli renderer tests
# include_str! must be in the repository or `cargo test` cannot build.
/test-data/*
!/test-data/cli/
/rotonda

